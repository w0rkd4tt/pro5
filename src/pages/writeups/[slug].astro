---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostDetail from '../../components/PostDetail.astro';
import WriteupProtection from '../../components/WriteupProtection.astro';
import { getPostsByType } from '../../lib/posts';
import { site } from '../../config/site';

export async function getStaticPaths() {
  return getPostsByType(await getCollection('posts'), 'writeup').map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} currentPath="/writeups">
  <WriteupProtection password={site.writeupPassword}>
    <PostDetail entry={entry} Content={Content} headings={headings} />
  </WriteupProtection>
</BaseLayout>
