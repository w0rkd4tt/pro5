---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolio, site } from '../config/site';
import { sitePath } from '../lib/paths';
import { postPath } from '../lib/posts';
import { cveRecords, cveNumber } from '../data/cves';
---
<BaseLayout title="Security Research Portfolio" currentPath="/">
  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="terminal-window">
      <div class="terminal-titlebar"><span class="traffic"><i></i><i></i><i></i></span><span>{site.terminalIdentity}</span></div>
      <div class="terminal-body">
        <p class="command">$ whoami</p>
        <h1 id="hero-title"><span class="type-name">{site.name} <em>"{site.nickname}"</em></span><b aria-hidden="true">_</b></h1>
        <p class="command">$ cat roles.txt</p>
        <p class="hero-roles">{portfolio.roles}</p>
        <p class="hero-copy">{portfolio.introduction}</p>
        <div class="hero-actions"><a class="button button-solid" href="#projects">Explore My Work</a><a class="button button-outline" href="#certifications">View Credentials</a></div>
      </div>
    </div>
  </section>

  <section class="section reveal" id="skills" aria-labelledby="skills-title">
    <header class="section-title"><p>$ ls ~/skills</p><h2 id="skills-title">Skills</h2><i></i></header>
    <div class="skills-grid">{portfolio.skillGroups.map((group) => <article class:list={['skill-card', { others: group.title === 'Others' }]}><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
  </section>

  <section class="section reveal" id="research" aria-labelledby="research-title">
    <header class="section-title"><p>$ cat cves.log</p><h2 id="research-title">Research</h2><i></i></header>
    {cveRecords.length === 0 && <p class="empty-state">No published CVEs indexed yet. Add records in <code>src/data/cves.ts</code>.</p>}
    {cveRecords.length > 0 && <Fragment><div class="cve-controls"><label class="mono">SORT <select id="cve-sort"><option value="oldest-first">Oldest → Newest</option><option value="severity-asc">Moderate → Critical</option><option value="severity-desc">Critical → Moderate</option></select></label></div>
    <div class="cve-table-wrap"><table class="cve-table"><thead><tr><th>CVE Number</th><th>Program</th><th>Severity</th></tr></thead><tbody id="cve-body">{[...cveRecords].sort((a, b) => cveNumber(a.cve) - cveNumber(b.cve)).map((record) => <tr data-cve={record.cve} data-severity={record.severity}><td>{record.writeup ? <a href={sitePath(postPath('writeup', record.writeup))}>{record.cve}</a> : <a href={record.reference} target="_blank" rel="noreferrer">{record.cve}</a>}</td><td>{record.program}</td><td><span class:list={['severity', `severity-${record.severity.toLowerCase()}`]}>{record.severity} {record.score}</span></td></tr>)}</tbody></table></div></Fragment>}
  </section>

  <section class="section reveal" id="certifications" aria-labelledby="certifications-title">
    <header class="section-title"><p>$ cat credentials.log</p><h2 id="certifications-title">Certifications & Achievements</h2><i></i></header>
    <div class="cert-groups"><article class="cert-category"><h3>Certifications</h3>{portfolio.certifications.length === 0 ? <p class="empty-state">No certificates indexed yet.</p> : <ul class="achievement-list">{portfolio.certifications.map((certification) => <li>{certification.title}{certification.issuer && <span class="muted"> — {certification.issuer}</span>}</li>)}</ul>}</article><article class="cert-category"><h3>Achievements</h3>{portfolio.achievements.length === 0 ? <p class="empty-state">No achievements indexed yet.</p> : <ul class="achievement-list">{portfolio.achievements.map((achievement) => <li>{achievement}</li>)}</ul>}</article></div>
  </section>

  <section class="section reveal" id="projects" aria-labelledby="projects-title">
    <header class="section-title"><p>$ ls ~/projects</p><h2 id="projects-title">Projects</h2><i></i></header>
    <div class="project-grid">{portfolio.projects.map((project) => <article class="project-card"><div><h3>{project.title}</h3><p>{project.description}</p><div class="tags"><span>{project.language}</span></div></div><a class="button button-outline" href={project.url} target="_blank" rel="noreferrer">View Project</a></article>)}</div>
  </section>

  {portfolio.publications.length > 0 && <section class="section reveal" id="publications" aria-labelledby="publications-title">
    <header class="section-title"><p>$ cat publications.log</p><h2 id="publications-title">Publications</h2><i></i></header>
    <div class="publication-grid">{portfolio.publications.map((publication) => <article class="publication-card"><p class="publication-venue">{publication.venue}</p><h3>{publication.title}</h3><p>{publication.description}</p><a class="button button-outline" href={publication.url.startsWith('/') ? sitePath(publication.url) : publication.url} target="_blank" rel="noreferrer">{publication.linkLabel} ↗</a></article>)}</div>
  </section>}

  <section class="section contact-section reveal" id="contact" aria-labelledby="contact-title">
    <header class="section-title"><p>$ ping collaborator</p><h2 id="contact-title">Contact</h2><i></i></header>
    <div class="contact-card"><p>Found a bug in something I built, or want to trade notes on an engagement? Ping me.</p><dl><div><dt>EMAIL</dt><dd><a href={portfolio.contact.email}>{portfolio.contact.label}</a></dd></div><div><dt>GITHUB</dt><dd><a href={portfolio.contact.github} target="_blank" rel="noreferrer">{portfolio.contact.githubLabel}</a></dd></div>{portfolio.contact.linkedin && <div><dt>LINKEDIN</dt><dd><a href={portfolio.contact.linkedin} target="_blank" rel="noreferrer">{portfolio.contact.linkedinLabel}</a></dd></div>}</dl></div>
  </section>

  <script>
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveal = document.querySelectorAll('.reveal');
    if (reduceMotion) reveal.forEach((section) => section.classList.add('is-visible'));
    if (!reduceMotion) { const observer = new IntersectionObserver((entries, current) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); current.unobserve(entry.target); } }), { threshold: .12 }); reveal.forEach((section) => observer.observe(section)); }
  </script>
<script>
  const cveSort = document.querySelector<HTMLSelectElement>('#cve-sort');
  const cveBody = document.querySelector<HTMLElement>('#cve-body');
  const severityRank: Record<string, number> = { Low: 1, Moderate: 2, High: 3, Critical: 4 };
  const cveNumber = (cve: string) => Number(cve.split('-').pop() ?? 0);
  const applyCveSort = () => {
    if (!cveSort || !cveBody) return;
    const mode = cveSort.value;
    const rows = [...cveBody.querySelectorAll('tr')];
    rows.sort((a, b) => {
      const numA = cveNumber(a.dataset.cve ?? '');
      const numB = cveNumber(b.dataset.cve ?? '');
      const rankA = severityRank[a.dataset.severity ?? ''] ?? 0;
      const rankB = severityRank[b.dataset.severity ?? ''] ?? 0;
      if (mode === 'severity-asc') return rankA - rankB || numA - numB;
      if (mode === 'severity-desc') return rankB - rankA || numA - numB;
      return numA - numB;
    });
    rows.forEach((row) => cveBody.appendChild(row));
  };
  cveSort?.addEventListener('change', applyCveSort);
</script>
</BaseLayout>
