<canvas class="constellation-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.constellation-canvas');

  if (canvas) {
    const context = canvas.getContext('2d');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let frameId = 0;
    let visible = !document.hidden;
    let nodes: Array<{ x: number; y: number; vx: number; vy: number; radius: number; alpha: number }> = [];

    const nodeCount = () => innerWidth <= 480 ? 22 : innerWidth <= 900 ? 35 : 48;
    const connectionDistance = () => 200;

    const createNodes = () => {
      nodes = Array.from({ length: nodeCount() }, () => {
        const speed = 0.1 + Math.random() * 0.18;
        const angle = Math.random() * Math.PI * 2;
        return { x: Math.random() * innerWidth, y: Math.random() * innerHeight, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed, radius: 1 + Math.random(), alpha: 0.5 + Math.random() * 0.2 };
      });
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(innerWidth * dpr);
      canvas.height = Math.round(innerHeight * dpr);
      canvas.style.width = `${innerWidth}px`;
      canvas.style.height = `${innerHeight}px`;
      context?.setTransform(dpr, 0, 0, dpr, 0, 0);
      createNodes();
      draw(false);
    };

    const draw = (move: boolean) => {
      if (!context) return;
      context.clearRect(0, 0, innerWidth, innerHeight);
      const distanceLimit = connectionDistance();
      for (const node of nodes) {
        if (move) {
          node.x += node.vx;
          node.y += node.vy;
          if (node.x <= 0 || node.x >= innerWidth) node.vx *= -1;
          if (node.y <= 0 || node.y >= innerHeight) node.vy *= -1;
          node.x = Math.max(0, Math.min(innerWidth, node.x));
          node.y = Math.max(0, Math.min(innerHeight, node.y));
        }
      }
      for (let index = 0; index < nodes.length; index += 1) {
        for (let otherIndex = index + 1; otherIndex < nodes.length; otherIndex += 1) {
          const node = nodes[index];
          const other = nodes[otherIndex];
          const distance = Math.hypot(node.x - other.x, node.y - other.y);
          if (distance > distanceLimit) continue;
          context.beginPath();
          context.moveTo(node.x, node.y);
          context.lineTo(other.x, other.y);
          context.strokeStyle = `rgba(0, 255, 127, ${(1 - distance / distanceLimit) * 0.32})`;
          context.lineWidth = 0.8;
          context.stroke();
        }
      }
      for (const node of nodes) {
        context.beginPath();
        context.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
        context.fillStyle = `rgba(0, 255, 127, ${node.alpha})`;
        context.fill();
      }
    };

    const animate = () => {
      if (!visible || reducedMotion.matches) return;
      draw(true);
      frameId = requestAnimationFrame(animate);
    };
    const visibilityChange = () => {
      visible = !document.hidden;
      cancelAnimationFrame(frameId);
      if (visible && !reducedMotion.matches) frameId = requestAnimationFrame(animate);
    };
    const motionChange = () => {
      cancelAnimationFrame(frameId);
      draw(false);
      if (!reducedMotion.matches && visible) frameId = requestAnimationFrame(animate);
    };
    const cleanup = () => {
      cancelAnimationFrame(frameId);
      removeEventListener('resize', resize);
      document.removeEventListener('visibilitychange', visibilityChange);
      reducedMotion.removeEventListener('change', motionChange);
      document.removeEventListener('astro:before-swap', cleanup);
    };

    resize();
    if (!reducedMotion.matches) frameId = requestAnimationFrame(animate);
    addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', visibilityChange);
    reducedMotion.addEventListener('change', motionChange);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }
</script>
