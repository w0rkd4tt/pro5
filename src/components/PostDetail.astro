---
import { sitePath } from '../lib/paths';
type Heading = { depth: number; slug: string; text: string }; type PostEntry = { data: { type: 'writeup' | 'blog'; slug: string; coverImage?: string; title: string; date: Date; tags: string[] } }; const { entry, Content, headings } = Astro.props as { entry: PostEntry; Content: any; headings: Heading[] }; const isWriteup = entry.data.type === 'writeup'; const back = isWriteup ? '/writeups/' : '/blog/'; const label = isWriteup ? 'Write-Ups' : 'Blog';
---
<div class="reading-progress" aria-hidden="true"></div><section class="post-detail"><a class="post-back" href={sitePath(back)}>← Back to {label}</a><div class="post-layout"><article class="article"><header>{entry.data.coverImage && <img class="article-cover" src={sitePath(entry.data.coverImage)} alt={`Abstract cover for ${entry.data.title}`} />}<p class="command">$ cat {entry.data.slug}.md</p><h1>{entry.data.title}</h1><p class="article-meta"><time>{entry.data.date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}</time>{entry.data.tags.map((tag) => <span>{tag}</span>)}</p></header><Content /></article>{headings.length > 0 && <aside class="toc"><p>ON THIS PAGE</p><nav>{headings.filter((heading) => heading.depth < 4).map((heading) => <a class:list={{ sub: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}</nav></aside>}</div></section><script>const bar=document.querySelector('.reading-progress');const links=[...document.querySelectorAll('.toc a')];const update=()=>{const max=document.documentElement.scrollHeight-innerHeight;bar?.setAttribute('style',`transform:scaleX(${max?scrollY/max:0})`);let active='';document.querySelectorAll('.article h2,.article h3').forEach((heading)=>{if(heading.getBoundingClientRect().top<150) active=heading.id;});links.forEach((link)=>link.classList.toggle('active',link.getAttribute('href')===`#${active}`));};addEventListener('scroll',update,{passive:true});update();</script>
